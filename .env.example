# Frontend-safe values. Vite only exposes variables prefixed with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000
VITE_GA_ID=G-XXXXXXXXXX

# Backend-only secrets/config.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=name-your-database
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set true for live Stripe webhooks, false for test-mode webhooks.
STRIPE_LIVE_MODE=false
# Set production to disable API docs and enforce production startup checks.
ENVIRONMENT=development
MAX_REQUEST_BODY_BYTES=1048576
FRONTEND_URL=http://localhost:5173
